# MongoDB Atlas connection string. Leave empty to use the in-memory mock DB.
MONGODB_URI=
MONGODB_DB=travel_planner
# Google Cloud key with Maps JavaScript API + Places API (New) enabled.
# Leave empty to fall back to OpenStreetMap (Leaflet + Nominatim).
GOOGLE_MAPS_API_KEY=
# Gemini key for the AI assistant / itinerary generator. Empty = rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
